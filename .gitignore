# Go
/daemon/bin/
*.test
*.out
coverage.*

# Go build/data artifacts
/daemon/data/
/data/

# Node / Vite (production frontend)
node_modules/
dist/
.vite/
*.tsbuildinfo

# Fallback UI compiled output is embedded; keep a committed placeholder only.
# daemon/web/dist holds a tracked placeholder index.html so the //go:embed
# builds offline; real build output (other files) is ignored.
daemon/web/dist/*
!daemon/web/dist/index.html

# Editor / OS junk
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
*.log
